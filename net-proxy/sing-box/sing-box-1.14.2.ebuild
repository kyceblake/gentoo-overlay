 "honnef.co/go/tools v0.0.0-20190102054323-c2f93a96b099/go.mod"
 "honnef.co/go/tools v0.0.0-20190523083050-ea95bdfd59fc/go.mod"
 "howett.net/plist v1.0.1"
 "howett.net/plist v1.0.1/go.mod"
 "lukechampine.com/blake3 v1.3.0"
 "lukechampine.com/blake3 v1.3.0/go.mod"
 "software.sslmate.com/src/go-pkcs12 v0.4.0"
 "software.sslmate.com/src/go-pkcs12 v0.4.0/go.mod"
 "zombiezen.com/go/capnproto2 v2.18.2+incompatible"
 "zombiezen.com/go/capnproto2 v2.18.2+incompatible/go.mod"
)
go-module_set_globals
DESCRIPTION="Universal proxy platform with Clash API and OpenRC integration"
HOMEPAGE="https://sing-box.sagernet.org/"
SRC_URI="https://github.com/SagerNet/sing-box/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
 ${EGO_SUM_SRC_URI}"
LICENSE="GPL-3 Apache-2.0 BSD MIT MPL-2.0 ISC"
SLOT="0"
KEYWORDS="~amd64"
IUSE="+tun nftables naive +tor"
RESTRICT="test mirror"
BDEPEND=">=dev-lang/go-1.25.5"
RDEPEND="app-misc/ca-certificates app-admin/sudo acct-user/sing-box acct-group/sing-box tor? ( net-vpn/tor )"
# Cronet's prebuilt Go modules are deliberately excluded from SRC_URI.
# naive uses dynamic loading of a separately source-built libcronet.so.
pkg_pretend() {
 if use naive && [[ ! -f ${EROOT}/usr/lib64/libcronet.so && ! -f ${EROOT}/usr/lib/libcronet.so ]]; then
  eerror "USE=naive requires a separately source-built libcronet.so from sagernet/cronet-go."
  eerror "Build/install that library first. Prebuilt Cronet downloads are not used."
  die "Source-built Cronet library required for USE=naive"
 fi
}
pkg_setup() {
 CONFIG_CHECK=""
 if use tun; then
  CONFIG_CHECK="~TUN ~IP_ADVANCED_ROUTER ~IP_MULTIPLE_TABLES ~IPV6_MULTIPLE_TABLES"
 fi
 if use nftables; then
  CONFIG_CHECK+=" ~NETFILTER ~NF_TABLES ~NF_TABLES_INET ~NF_CONNTRACK ~NF_NAT ~NFT_CT ~NFT_NAT ~NFT_REDIR"
 fi
 linux-info_pkg_setup
}
src_compile() {
 local tags="with_gvisor,with_quic,with_dhcp,with_wireguard,with_utls,with_acme,with_clash_api,with_tailscale,with_cloudflared,with_usbip,with_openvpn,with_openconnect,with_grpc,with_v2ray_api,badlinkname,tfogo_checklinkname0"
 use naive && tags+=",with_naive_outbound,with_purego"
 export CGO_ENABLED=0 GOTOOLCHAIN=local
 ego build -p 8 -trimpath -tags "${tags}" -ldflags "-s -w -X github.com/sagernet/sing-box/constant.Version=${PV} -checklinkname=0" -o sing-box ./cmd/sing-box
}
src_install() {
 dobin sing-box
 newinitd "${FILESDIR}/sing-box.initd" sing-box
 newconfd "${FILESDIR}/sing-box.confd" sing-box
 insinto /usr/share/sing-box
 doins "${FILESDIR}/kernel.config"
 dodoc LICENSE README.md
 dodir /etc/sing-box /var/lib/sing-box
 fowners root:sing-box /etc/sing-box
 fperms 2770 /etc/sing-box
 fowners sing-box:sing-box /var/lib/sing-box
 fperms 0750 /var/lib/sing-box
 insinto /etc/sudoers.d
 insopts -m 0440
 newins "${FILESDIR}/sing-box.sudoers" sing-box
}
pkg_postinst() {
 elog "Service remains stopped. Provide /etc/sing-box/config.json before starting."
 elog "Kernel fragment: /usr/share/sing-box/kernel.config (apply when rebuilding your kernel)."
 elog "USE=tun and USE=nftables check kernel support; ebuilds do not rebuild kernels."
 elog "USE=naive enables NaiveProxy with separately source-built libcronet.so."
}
