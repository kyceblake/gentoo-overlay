_GOMODULE_GOPROXY_BASEURI="https://proxy.golang.org"
go-module_set_globals
DESCRIPTION="Mihomo proxy core with OpenRC integration"
HOMEPAGE="https://github.com/MetaCubeX/mihomo"
SRC_URI="https://github.com/MetaCubeX/mihomo/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
 ${EGO_SUM_SRC_URI}"
LICENSE="GPL-3 Apache-2.0 BSD MIT MPL-2.0 ISC"
SLOT="0"
KEYWORDS="~amd64"
IUSE="+tun"
RESTRICT="test mirror"
BDEPEND=">=dev-lang/go-1.25"
RDEPEND="app-misc/ca-certificates app-admin/sudo acct-user/mihomo acct-group/mihomo"
pkg_setup() {
 CONFIG_CHECK=""
 use tun && CONFIG_CHECK="~TUN ~IP_ADVANCED_ROUTER ~IP_MULTIPLE_TABLES ~IPV6_MULTIPLE_TABLES"
 linux-info_pkg_setup
}
src_compile() {
 export CGO_ENABLED=0 GOTOOLCHAIN=local
 ego build -p 8 -trimpath -tags with_gvisor,no_easytier -ldflags "-s -w -X github.com/metacubex/mihomo/constant.Version=${PV}" -o mihomo .
}
src_install() {
 dobin mihomo
 newinitd "${FILESDIR}/mihomo.initd" mihomo
 keepdir /etc/mihomo /var/lib/mihomo
 fowners root:mihomo /etc/mihomo
 fperms 2770 /etc/mihomo
 local marker
 for marker in "${ED}"/etc/mihomo/.keep*; do
  fowners root:mihomo "${marker#${ED}}"
  fperms 0660 "${marker#${ED}}"
 done
 fowners mihomo:mihomo /var/lib/mihomo
 fperms 0750 /var/lib/mihomo
 insinto /etc/sudoers.d
 insopts -m 0440
 newins "${FILESDIR}/mihomo.sudoers" mihomo
 dodoc README.md
}
pkg_postinst() {
 elog "Provide /etc/mihomo/config.yaml before starting the service."
 elog "Add trusted administrators to the mihomo group for ClashTUI integration."
}
