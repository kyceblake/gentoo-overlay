inherit cargo
DESCRIPTION="Terminal interface for sing-box and Mihomo"
HOMEPAGE="https://github.com/JohanChane/clashtui"
COMMIT="5f644c857c2f39b62a4287ce43cd13e469cd4c14"
SRC_URI="https://github.com/JohanChane/clashtui/archive/${COMMIT}.tar.gz -> ${P}.tar.gz
 ${CARGO_CRATE_URIS}"
S="${WORKDIR}/clashtui-${COMMIT}"
LICENSE="MIT Apache-2.0 BSD ISC Unicode-3.0 MPL-2.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64"
IUSE="test"
RESTRICT="mirror !test? ( test )"
RDEPEND="app-admin/sudo app-shells/fzf"
PATCHES=( "${FILESDIR}/gentoo-defaults.patch" )
src_configure() {
 export CLASHTUI_VERSION="${PV}-gentoo"
 cargo_src_configure --no-default-features --features tui,ratatui/serde
}
src_install() {
 cargo_src_install
 dodoc README.md
 docinto examples
 dodoc -r contrib/default_configs
}
pkg_postinst() {
 elog "Use Portage to update ClashTUI and proxy cores; binary self-updates are disabled."
 elog "OpenRC defaults use /etc/sing-box/config.json and the sing-box service."
 elog "Install net-proxy/sing-box separately. No proxy is started automatically."
}
